<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="009-create-tables-equipos-cisternas" author="maria-conde">
        <comment>Creación de tablas para Equipos Industriales y Despacho de Cisternas</comment>

        <!-- 1. Tabla: equipos_industriales -->
        <createTable tableName="equipos_industriales" remarks="Equipos de Proceso, Cabezas de Pozo, Tanques y Separadores">
            <column name="id" type="varchar(50)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tag" type="varchar(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="nombre" type="varchar(150)">
                <constraints nullable="false"/>
            </column>
            <column name="tipo" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="campo" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="presion_critica" type="decimal(10,2)" defaultValueNumeric="0.00">
                <constraints nullable="false"/>
            </column>
            <column name="caudal_produccion" type="decimal(10,2)" defaultValueNumeric="0.00">
                <constraints nullable="false"/>
            </column>
            <column name="estado" type="varchar(30)" defaultValue="OPERATIVO"/>
            <column name="tiempo_conexion_seg" type="int" defaultValueNumeric="2"/>
            <column name="fecha_actualizacion" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP"/>
        </createTable>

        <!-- 2. Tabla: despachos_cisternas -->
        <createTable tableName="despachos_cisternas" remarks="Registro de Cargas de Hidrocarburos en Islas de Despacho">
            <column name="id" type="varchar(50)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="numero_guia" type="varchar(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="placa_cisterna" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="transportadora" type="varchar(150)">
                <constraints nullable="false"/>
            </column>
            <column name="conductor" type="varchar(150)">
                <constraints nullable="false"/>
            </column>
            <column name="isla" type="varchar(30)">
                <constraints nullable="false"/>
            </column>
            <column name="volumen_solicitado" type="decimal(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="volumen_cargado" type="decimal(10,2)" defaultValueNumeric="0.00">
                <constraints nullable="false"/>
            </column>
            <column name="precinto_fiscal" type="varchar(50)"/>
            <column name="estado" type="varchar(30)" defaultValue="EN LLENADO"/>
            <column name="fecha_despacho" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

