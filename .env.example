# ==============================================================================
# PROYECTO MAPAF - Variables de Entorno (Plantilla de Configuración)
# SENA ADSO · Ficha 3413988 | XAMPP (Apache + PHP 8 + MySQL)
# ==============================================================================

# Credenciales de Base de Datos MySQL (XAMPP por defecto: 127.0.0.1:3306, root, sin password)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mapaf_db
DB_USER=root
DB_PASS=

# Configuración de la Aplicación
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/mapaf/
