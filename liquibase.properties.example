# ==============================================================================
# PROYECTO MAPAF - Plantilla de Configuración Liquibase (Entornos)
# ==============================================================================
changeLogFile=db/changelog/db.changelog-master.xml
url=jdbc:mysql://${DB_HOST:127.0.0.1}:${DB_PORT:3306}/${DB_NAME:mapaf_db}?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Bogota
username=${DB_USER:root}
password=${DB_PASSWORD:}
driver=com.mysql.cj.jdbc.Driver
liquibase.hub.mode=off
